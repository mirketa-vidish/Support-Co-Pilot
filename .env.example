# Groq (OpenAI-compatible tool-calling API)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback: Google Gemini (free key at https://aistudio.google.com/apikey).
# When Groq hits its daily limit, investigations switch to Gemini for the rest of that day
# (and back to Groq if Gemini hits its own daily limit). Leave blank to disable the fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Local embedding model (downloaded once from HuggingFace, runs offline after that)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where the persistent Chroma vector DB is stored
CHROMA_DB_DIR=./chroma_db
